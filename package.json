{
  "name": "@j3pf/rp-relay",
  "version": "0.6.0",
  "description": "Relay autoalojable que conecta agentes Pi con la app Android RP",
  "type": "module",
  "bin": {
    "rp-relay": "dist/cli/index.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "migrations",
    "deploy",
    "docs",
    "README.md"
  ],
  "bundledDependencies": [
    "@j3pf/rp-protocol"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist packages/protocol/dist *.tsbuildinfo packages/protocol/*.tsbuildinfo",
    "dev": "tsx src/cli/index.ts serve",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && vitest run",
    "test:load": "tsx test/load/load.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@j3pf/rp-protocol": "0.6.0",
    "@sinclair/typebox": "^0.34.52",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "ulid": "^3.0.2",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "acme-client": "^5.4.0",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j3pf/rp-relay.git"
  },
  "keywords": [
    "pi",
    "agent",
    "relay",
    "push",
    "websocket"
  ]
}
