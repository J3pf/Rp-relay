{
  "name": "@j3pf/rp-relay",
  "version": "0.1.0",
  "description": "Relay autoalojable que conecta agentes Pi con la app Android RP",
  "type": "module",
  "bin": {
    "rp-relay": "dist/cli/index.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "migrations",
    "deploy",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist packages/protocol/dist *.tsbuildinfo packages/protocol/*.tsbuildinfo",
    "dev": "tsx src/cli/index.ts serve",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:load": "tsx test/load/load.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@j3pf/rp-protocol": "0.1.0",
    "@sinclair/typebox": "^0.34.0",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.12.0",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0",
    "ulid": "^3.0.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "acme-client": "^5.4.0",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j3pf/rp-relay.git"
  },
  "keywords": [
    "pi",
    "agent",
    "relay",
    "push",
    "websocket"
  ]
}
