[Unit]
Description=RP relay (agentes Pi ⇄ app Android)
Documentation=https://github.com/j3pf/rp-relay
After=network-online.target
Wants=network-online.target

[Service]
# El relay avisa a systemd con sd_notify (vía systemd-notify): READY=1 al escuchar y WATCHDOG=1 cada 10 s.
# Si la base de datos deja de responder el watchdog no se notifica y systemd lo reinicia.
Type=notify
NotifyAccess=all
WatchdogSec=30
User=rp-relay
Group=rp-relay
Environment=RP_CONFIG=/etc/rp-relay/config.json
Environment=NODE_ENV=production
ExecStart=/usr/bin/rp-relay serve
Restart=always
RestartSec=2
# SIGTERM → cierre ordenado: avisa a todos los clientes con 1012 (service restart) y vacía escrituras
KillSignal=SIGTERM
TimeoutStopSec=20

# Aislamiento
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rp-relay
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# Sólo necesario para el TLS integrado (opción A2: el relay escucha en 80/443 sin Caddy):
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
